{
  "name": "@dsh-external/dsh-rtk",
  "version": "0.2.0",
  "description": "DSH thin adapter for RTK: auto-rewrites pwsh commands to rtk, adds a dedicated rtk tool, and handles Windows/PowerShell compatibility.",
  "private": true,
  "keywords": [
    "dsh",
    "rtk",
    "deepseek-harness",
    "token-saving",
    "powershell",
    "windows",
    "cordis",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao-hans/dsh-rtk.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test --experimental-test-isolation=none tests/rewrite.test.mjs tests/integration.test.mjs tests/schema.test.mjs"
  }
}
