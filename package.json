{
  "name": "@dsh-external/dsh-rtk",
  "version": "0.1.0",
  "description": "DSH thin adapter for RTK: auto-rewrites pwsh commands to rtk, adds a dedicated rtk tool, and handles Windows/PowerShell compatibility.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/rewrite.test.mjs tests/integration.test.mjs tests/schema.test.mjs"
  }
}
